{
  "expo": {
    "name": "Code Without Limits",
    "slug": "code-without-limits",
    "scheme": "codewithoutlimits",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F1E6D3",
    "splash": {
      "backgroundColor": "#F1E6D3",
      "resizeMode": "contain",
      "image": "./assets/splash.png"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "net.codewithoutlimits.app",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false
        }
      }
    },
    "android": {
      "package": "net.codewithoutlimits.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F1E6D3"
      },
      "permissions": [],
      "usesCleartextTraffic": false
    },
    "extra": {
      "apiUrl": "https://api.codewithoutlimits.net/api",
      "eas": { "projectId": "replace-with-your-eas-project-id" }
    },
    "plugins": ["expo-secure-store"]
  }
}
