# =============================================================================
# Code Without Limits — API environment template
# =============================================================================
# Copy this file to ".env" in the same folder (apps/api/.env) and fill in the
# three required secrets below. Do NOT commit your real .env file.
#
#   cp .env.example .env
#
# The application validates this configuration at startup and will refuse to
# start if a required secret is missing or left at a placeholder value.
# =============================================================================


# ----- REQUIRED: you must provide real values for these three -----------------

# Your MongoDB connection string, including username and password.
# Form: mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/codewithoutlimits?retryWrites=true&w=majority
MONGODB_URI=

# Secret used to sign short-lived access tokens.
# Generate a long random value, e.g.:  openssl rand -base64 48
JWT_ACCESS_SECRET=

# Secret used to sign refresh tokens. Use a DIFFERENT random value from the one above.
# Generate with:  openssl rand -base64 48
JWT_REFRESH_SECRET=


# ----- OPTIONAL: sensible defaults are built in; change only if you need to ---

# Runtime mode: development | test | production
NODE_ENV=development

# Port the API server listens on
PORT=4000

# Database name inside your MongoDB cluster
MONGODB_DB_NAME=codewithoutlimits

# How long access and refresh tokens remain valid
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Comma-separated list of allowed browser origins for CORS.
# In production, set this to your deployed web address and do NOT use "*".
CORS_ORIGINS=http://localhost:5173

# Cookie domain (leave blank for local development)
COOKIE_DOMAIN=

# Public address of the deployed web front end
PUBLIC_WEB_URL=https://codewithoutlimits.net

# Location of the course content folder, relative to the API
CONTENT_DIR=../../content

# Demo mode: true | false
DEMO_MODE_ENABLED=true

# Number of proxy hops to trust (0–5); 1 is correct behind a single proxy/CDN
TRUST_PROXY_HOPS=1

# Logging verbosity: info | debug | warn | error
LOG_LEVEL=info
