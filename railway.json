{
  "$schema": "https://railpack.com/schema.json",
  "build": {
    "provider": "node"
  },
  "deploy": {
    "startCommand": "node apps/api/src/index.js",
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 30,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "numReplicas": 1
  }
}
