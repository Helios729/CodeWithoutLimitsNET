{
  "$meta": {
    "app": "Code Without Limits",
    "domain": "codewithoutlimits.net",
    "archetype": "Terracotta & Sage",
    "familyPosition": 1,
    "familySize": 3,
    "note": "Structure (type, spacing, radii, shapes, icons) is shared across the three-app family. Only the values in `color` are re-themed per app. Do not add structural changes when theming apps 2 and 3. Palette restored from the original app theme; danger is a distinct deep red, never reused for the brand."
  },
  "color": {
    "background_primary": {
      "value": "#F7F5F0",
      "name": "Warm Sand",
      "usage": "App/website base background"
    },
    "background_secondary": {
      "value": "#FFFFFF",
      "name": "Surface White",
      "usage": "Cards, elevated surfaces"
    },
    "text_primary": {
      "value": "#1A1A1A",
      "name": "Near Black",
      "usage": "Headings, primary body text"
    },
    "text_secondary": {
      "value": "#5C5E54",
      "name": "Warm Grey",
      "usage": "Secondary/supporting text"
    },
    "brand_primary": {
      "value": "#C84C31",
      "name": "Terracotta",
      "usage": "Primary buttons, key brand moments"
    },
    "brand_primary_active": {
      "value": "#A84430",
      "name": "Terracotta Active",
      "usage": "Pressed/active states"
    },
    "brand_secondary": {
      "value": "#4A5D4E",
      "name": "Sage",
      "usage": "Secondary actions, meters, icon accents"
    },
    "accent_warm": {
      "value": "#E6B87D",
      "name": "Peach",
      "usage": "Highlights, subtle emphasis, hover states"
    },
    "border_subtle": {
      "value": "#E5E2D9",
      "name": "Sand Border",
      "usage": "Card borders, dividers, input outlines"
    },
    "success": {
      "value": "#4A5D4E",
      "name": "Sage",
      "usage": "Correct answers, positive states"
    },
    "danger": {
      "value": "#8A2317",
      "name": "Deep Red",
      "usage": "Incorrect answers, errors, destructive actions"
    },
    "on_brand": {
      "value": "#FFFFFF",
      "name": "White",
      "usage": "Required text colour on brand_primary / brand_secondary"
    }
  },
  "typography": {
    "display": {
      "family": "Outfit",
      "fallback": "system-ui, sans-serif",
      "weight": 600,
      "tracking": "-0.02em"
    },
    "body": {
      "family": "DM Sans",
      "fallback": "system-ui, sans-serif",
      "weight": 400,
      "leading": 1.65
    },
    "scale": {
      "overline": {
        "size": "0.75rem",
        "weight": 600,
        "tracking": "0.14em",
        "transform": "uppercase"
      },
      "caption": {
        "size": "0.8125rem",
        "weight": 400
      },
      "body": {
        "size": "1rem",
        "weight": 400
      },
      "body_lg": {
        "size": "1.125rem",
        "weight": 400
      },
      "h4": {
        "size": "1.25rem",
        "weight": 600
      },
      "h3": {
        "size": "1.5rem",
        "weight": 600
      },
      "h2": {
        "size": "2rem",
        "weight": 600
      },
      "h1": {
        "size": "2.75rem",
        "weight": 600
      }
    }
  },
  "space": {
    "0": "0",
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "24px",
    "6": "32px",
    "7": "48px",
    "8": "64px",
    "9": "96px"
  },
  "radius": {
    "sm": "8px",
    "md": "14px",
    "lg": "22px",
    "pill": "999px"
  },
  "shadow": {
    "card": "0 1px 2px rgba(42,33,27,0.04), 0 8px 24px rgba(42,33,27,0.06)",
    "raised": "0 2px 4px rgba(42,33,27,0.06), 0 16px 40px rgba(42,33,27,0.10)"
  },
  "motion": {
    "fast": "120ms",
    "base": "220ms",
    "slow": "420ms",
    "ease": "cubic-bezier(0.22, 0.61, 0.36, 1)"
  },
  "breakpoint": {
    "sm": "480px",
    "md": "768px",
    "lg": "1080px",
    "xl": "1320px"
  },
  "icon": {
    "set": "Phosphor",
    "style": "duotone",
    "primaryLayer": "brand_primary",
    "secondaryLayer": "brand_secondary"
  }
}
